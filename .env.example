# ==============================================================================
# METATRADER 5 (MT5) CONFIGURATION & CREDENTIALS
# ==============================================================================
# Silakan isi data akun MT5 Anda di bawah ini:
# CATATAN: File .env ini aman dan bersifat lokal di komputer Anda.

# 1. MT5 Account Credentials
MT5_ACCOUNT=0
MT5_PASSWORD=
MT5_SERVER=

# 2. MT5 Terminal Path (Opsional - biarkan kosong jika terpasang di lokasi default)
# Contoh: C:/Program Files/MetaTrader 5/terminal64.exe
MT5_PATH=

# 3. Trading Mode: DEMO atau REAL (Gunakan DEMO terlebih dahulu untuk verifikasi!)
MT5_MODE=DEMO

# 4. Telegram Notifications (Opsional - biarkan kosong jika tidak digunakan)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
